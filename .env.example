# ── Supabase ─────────────────────────────────────────────────────────────
# Leave the two NEXT_PUBLIC_* blank to run the portal in DEMO MODE (browser storage).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Required for Central Login (SSO) to bridge into a Supabase session.
SUPABASE_SERVICE_ROLE_KEY=

# ── Central Login (SSO) — optional ───────────────────────────────────────
# Turn the portal into a child app of sso.shd-technology.co.th. Leave blank to
# keep email/password login only.
NEXT_PUBLIC_SSO_ENABLED=            # "1" to show the "Sign in with Central Login" button
NEXT_PUBLIC_APP_URL=               # e.g. https://onespace-ose7.onrender.com (no trailing slash)
SSO_BASE_URL=https://sso.shd-technology.co.th
SSO_CLIENT_ID=                     # cli_… from the app's SSO/OIDC tab
SSO_CLIENT_SECRET=                 # shown once on the central dashboard — server-side only
